# Encadena los archivos de compose. Con las dos entradas se levanta tambien un
# Mongo local; para usar Atlas, deja solo docker-compose.yml y apunta MONGO_URI
# a tu cluster.
# El separador por defecto es ';' en Windows y ':' en Linux/macOS; se fija
# para que el mismo .env valga en cualquiera de los dos.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.local-db.yml

# Copia este archivo a .env y rellena los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

# --- MongoDB -----------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=cambia-esta-password
MONGO_DB=adivimat

# --- Backend -----------------------------------------------------------------
# 4000 y no 3000: el 3000 lo ocupa el servidor de desarrollo del frontend.
PORT=4000

# Dentro de docker-compose el host es el nombre del servicio, "mongo".
# Para correr el backend fuera de Docker, usa localhost.
MONGO_URI=mongodb://root:cambia-esta-password@mongo:27017/adivimat?authSource=admin

# Clave de firma de los JWT. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave
JWT_EXPIRES_IN=1h

# Codigo que exige /api/auth/register para crear un administrador.
ADMIN_CODE=cambia-este-codigo

# Origenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000

# --- Mongo Express -----------------------------------------------------------
# 8082 porque el 8081 puede estar ocupado por otro proyecto.
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USER=mongo
MONGO_EXPRESS_PASSWORD=cambia-esta-password

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000/

# --- MongoDB Atlas ----------------------------------------------------------
# Para usar Atlas en lugar del Mongo local:
#   1. COMPOSE_FILE=docker-compose.yml   (quita docker-compose.local-db.yml)
#   2. MONGO_URI con la cadena SRV de tu cluster, incluido el nombre de la
#      base de datos antes de la interrogacion:
#      mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/adivimat?retryWrites=true&w=majority
#   3. En Atlas, Network Access: autoriza la IP desde la que se conecta el
#      backend. Sin eso la conexion caduca sin mensaje claro.
#   4. Carga el temario:  npm run seed --workspace backend
#
# Si la password lleva @ : / ? # [ ] o %, hay que codificarla en porcentaje.
