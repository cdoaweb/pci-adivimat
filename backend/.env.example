# Solo para ejecutar el backend FUERA de Docker (npm run dev).
# Dentro de docker-compose las variables vienen del .env de la raiz, donde el
# host de Mongo es "mongo" (el nombre del servicio) en vez de localhost.

PORT=4000
MONGO_URI=mongodb://root:cambia-esta-password@localhost:27017/adivimat?authSource=admin
JWT_SECRET=cambia-esta-clave
JWT_EXPIRES_IN=1h
ADMIN_CODE=cambia-este-codigo
CORS_ORIGINS=http://localhost:3000
